# SignBridge — Environment Variables Template
# Copy this file to .env and fill in values. Never commit .env to git.

# Logging
LOG_LEVEL=INFO

# Paths (relative to project root, or absolute)
DATA_DIR=../Datasets
# Model paths
MODEL_DIR=backend/models
HOLISTIC_MODEL_PATH=backend/models/holistic_landmarker.task
PROCESSED_DATA_DIR=data/processed
SELF_RECORDED_DIR=data/self_recorded

# Inference
CONFIDENCE_THRESHOLD=0.85
PAUSE_TIMEOUT_SECONDS=1.5
COMMIT_STREAK=2

# Hardware
DEVICE=cpu

# Dataset-specific paths (override defaults if datasets live elsewhere)
INCLUDE_DATASET_DIR=../Datasets/INCLUDE
ISLVT_DATASET_DIR=../Datasets/Indian Sign Language Video and Text dataset for sentences (ISLVT)
ISL_DATASET_DIR=../Datasets/Indian Sign Language_Dataset
NGT_DATASET_DIR=../Datasets/NGT_HoReCo_1.2

# API (Phase 4)
API_HOST=0.0.0.0
API_PORT=8000
